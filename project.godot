; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sproutlandia"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputSetup="*res://scripts/systems/InputSetup.gd"
GameManager="*res://scripts/systems/GameManager.gd"
SceneTransition="*res://scripts/systems/SceneTransition.gd"
Sfx="*res://scripts/systems/Sfx.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
