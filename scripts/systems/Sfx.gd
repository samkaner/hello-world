extends Node
## Autoload sound service: pooled one-shot SFX players plus a single looping
## music player. All audio is generated by tools/audio/gen_audio.py -- see
## that script to regenerate or tweak the sounds.

const SOUNDS := {
	"jump": preload("res://assets/audio/sfx_jump.wav"),
	"hover": preload("res://assets/audio/sfx_hover.wav"),
	"attack": preload("res://assets/audio/sfx_attack.wav"),
	"hurt": preload("res://assets/audio/sfx_hurt.wav"),
	"stomp": preload("res://assets/audio/sfx_stomp.wav"),
	"enemy_die": preload("res://assets/audio/sfx_enemy_die.wav"),
	"pickup": preload("res://assets/audio/sfx_pickup.wav"),
	"checkpoint": preload("res://assets/audio/sfx_checkpoint.wav"),
	"level_clear": preload("res://assets/audio/sfx_level_clear.wav"),
	"boss_roar": preload("res://assets/audio/sfx_boss_roar.wav"),
	"boss_hit": preload("res://assets/audio/sfx_boss_hit.wav"),
	"game_over": preload("res://assets/audio/sfx_game_over.wav"),
	"victory": preload("res://assets/audio/sfx_victory.wav"),
}

const MUSIC := {
	"overworld": preload("res://assets/audio/music_overworld.wav"),
	"boss": preload("res://assets/audio/music_boss.wav"),
}

const POOL_SIZE := 8

var _pool: Array[AudioStreamPlayer] = []
var _next: int = 0
var _music_player: AudioStreamPlayer
var _current_track: String = ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.volume_db = -6.0
		add_child(p)
		_pool.append(p)

	_music_player = AudioStreamPlayer.new()
	_music_player.volume_db = -12.0
	add_child(_music_player)
	_music_player.finished.connect(func() -> void: _music_player.play())


func play(sound: String) -> void:
	if not SOUNDS.has(sound):
		push_warning("Sfx: unknown sound '%s'" % sound)
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = SOUNDS[sound]
	p.play()


func play_music(track: String) -> void:
	if track == _current_track:
		return
	_current_track = track
	if track == "" or not MUSIC.has(track):
		_music_player.stop()
		return
	_music_player.stream = MUSIC[track]
	_music_player.play()


func stop_music() -> void:
	play_music("")
